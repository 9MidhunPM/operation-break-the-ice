# Production HTTP port. Vite dev uses 5173.
PORT=8080

# Persistent SQLite database path.
DB_PATH=./data/event.sqlite

# Strong organiser/admin PIN. Never expose this in frontend code.
ADMIN_PIN=replace-with-a-strong-8-plus-character-secret

# Public URL encoded into projector/player QR codes.
PUBLIC_BASE_URL=https://your-event-domain.example

# Private senior config generated by npm run setup:seniors.
SENIOR_CONFIG_PATH=./private/seniors.json

# Directory containing childhood photos referenced by private senior config.
PRIVATE_CONTENT_DIR=./private/photos
