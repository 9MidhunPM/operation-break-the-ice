# Default dev values — safe to commit.
# For production, copy this file to .env and set real secret values.

# Organiser PIN required to reset a participant's game (release their slot).
# Defaults to 220806 if unset. ALWAYS set a strong value in production.
ORGANISER_PIN=220806

# Port for the production server (npm start). Dev always uses Vite's port.
PORT=8080

# Optional: override the SQLite file location.
# DB_PATH=./server/data.sqlite
